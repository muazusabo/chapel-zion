# ---- App ----
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ---- Database ----
DATABASE_URL="postgresql://USER:admin@HOST:5432/fcs-chapel-zion?schema=public"
DIRECT_URL="postgresql://USER:admin@DIRECT_HOST:5432/fcs-chapel-zion?schema=public"

# ---- JWT ----
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
JWT_RESET_SECRET=change_this_to_a_different_long_random_string
JWT_RESET_EXPIRES_IN=1h

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- SMTP / Email ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="SAZU FCS <no-reply@sazufcs.org>"

